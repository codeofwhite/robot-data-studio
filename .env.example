ROBOT_DATA_STUDIO_ISAACLAB_CONDA_PREFIX=/home/zhanghejun/miniconda3/envs/isaaclab
ROBOT_DATA_STUDIO_PUBLIC_IP=219.223.200.145
ROBOT_DATA_STUDIO_ISAAC_SIGNALING_PORT=49100
ROBOT_DATA_STUDIO_ISAAC_MEDIA_PORT=47998
