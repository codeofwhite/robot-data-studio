# Shell-sourced example: review paths before use. No credentials belong here.
# Run from the Studio repository root. Adjust WORKSPACE to your sibling checkouts.
WORKSPACE="${HOME}/robot-workspace"
STUDIO_ROOT="${PWD}"

NEXT_PUBLIC_STUDIO_API=http://127.0.0.1:8010/api
ROBOT_DATA_STUDIO_DB=${STUDIO_ROOT}/data/studio.db
ROBOT_DATA_STUDIO_DATA_ROOT=${STUDIO_ROOT}/data
ROBOT_DATA_STUDIO_CLOTHTWIN_ROOT=${WORKSPACE}/ClothTwin
# Use the interpreter/environment that can run Genesis + ClothTwin.
ROBOT_DATA_STUDIO_COLLECTOR_PYTHON=${WORKSPACE}/.venvs/genesis/bin/python
# Isaac Sim engine plugin. The launcher receives --gpu-id directly; Studio removes
# inherited CUDA_VISIBLE_DEVICES for this worker because Vulkan and CUDA must agree.
ROBOT_DATA_STUDIO_GELLO_REMOTE_ROOT=${WORKSPACE}/gello-remote
# RoboVerse stays in its own environment; Studio only launches its allowlisted worker.
ROBOT_DATA_STUDIO_ROBOVERSE_ROOT=${WORKSPACE}/RoboVerse
ROBOT_DATA_STUDIO_ROBOVERSE_PYTHON=${WORKSPACE}/envs/roboverse-maniskill/bin/python
ROBOT_DATA_STUDIO_ROBOVERSE_PICKCUBE_DEMO=${STUDIO_ROOT}/data/cache/maniskill/PickCube-v1/rl/trajectory.none.pd_joint_delta_pos.physx_cuda.h5
ROBOT_DATA_STUDIO_ISAACLAB_LAUNCHER=${WORKSPACE}/IsaacLab/isaaclab.sh
ROBOT_DATA_STUDIO_ISAACLAB_CONDA_PREFIX=${WORKSPACE}/.venvs/isaaclab
# localhost is suitable for local use; configure your reachable address for remote streaming.
ROBOT_DATA_STUDIO_PUBLIC_IP=127.0.0.1
ROBOT_DATA_STUDIO_ISAAC_SIGNALING_PORT=49100
ROBOT_DATA_STUDIO_ISAAC_MEDIA_PORT=47998
ROBOT_DATA_STUDIO_ISAAC_FRANKA_USD=https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/IsaacLab/Robots/FrankaEmika/panda_instanceable.usd
# Optional garment source; set to the ClothForge checkout used by your worker.
ROBOT_DATA_STUDIO_CLOTHFORGE_ROOT=${WORKSPACE}/ClothForge
ROBOT_DATA_STUDIO_ROBOVERSE_DEMO_ROOT=${STUDIO_ROOT}/data/cache/maniskill
# Each exporter can use a different isolated environment.
ROBOT_DATA_STUDIO_LEROBOT_PYTHON=python
ROBOT_DATA_STUDIO_OPENPI_ROOT=${WORKSPACE}/openpi
ROBOT_DATA_STUDIO_OPENPI_PYTHON=${WORKSPACE}/openpi/.venv/bin/python
# Supply your own checkpoint with the matching Franka joint8 action contract.
ROBOT_DATA_STUDIO_OPENPI_CHECKPOINT=${STUDIO_ROOT}/data/checkpoints/openpi
ROBOT_DATA_STUDIO_OPENPI_CONFIG=pi05_franka_joint8_lora
ROBOT_DATA_STUDIO_OPENPI_GPU_ID=0
ROBOT_DATA_STUDIO_OPENPI_INFERENCE_STEPS=2
ROBOT_DATA_STUDIO_FASTWAM_PYTHON=${WORKSPACE}/envs/lerobot-fastwam/bin/python
ROBOT_DATA_STUDIO_RLDS_PYTHON=python
ROBOT_DATA_STUDIO_ROBOMIMIC_PYTHON=${WORKSPACE}/.venvs/softmimicgen/bin/python
