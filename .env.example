# RoboVerse stays in its own environment; Studio only launches its allowlisted worker.
ROBOT_DATA_STUDIO_ROBOVERSE_ROOT=/data/zhanghejun/RoboVerse
ROBOT_DATA_STUDIO_ROBOVERSE_PYTHON=/data/zhanghejun/envs/roboverse-maniskill/bin/python
